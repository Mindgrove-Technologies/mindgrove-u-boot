/dts-v1/;

/ {
    #address-cells = <2>;
    #size-cells = <2>;
    compatible = "mindgrove,v26xx";
    model = "mindgrove,v26xx";

    aliases {
        serial0 = &uart0;
    };

    chosen {
        stdout-path = "serial0:1250000n8";
        /* Ensure bootargs point to the correct console */
        bootargs = "earlycon=sbi console=ttyLS0,1250000n8 root=/dev/mmcblk0p1 rootwait";
        
        opensbi_config: config {
            compatible = "opensbi,config";
            cold-boot-harts = <&CPU0 &CPU1 &CPU2 &CPU3>;
        };
    };

    /* * NEW: Reserved memory section. 
     * This tells Linux: "Do not touch this memory, it belongs to firmware/kernel text."
     */
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        /* Protect OpenSBI and the first 32MB of the kernel image */
        firmware_res: memory@80000000 {
            reg = <0x0 0x80000000 0x0 0x02000000>;
            no-map;
        };
    };

    /* Primary System RAM */
    memory@80000000 {
        device_type = "memory";
        reg = <0x0 0x80000000 0x0 0x8000000>; // 128MB
    };

    /* * FIXED: Changed device_type. 
     * If these are 'memory', Linux tries to use them as RAM. 
     * Flash cannot be used as system heap RAM.
     */
    flash@90000000 {
        compatible = "mtd-rom"; 
        reg = <0x0 0x90000000 0x0 0x8000000>;
        read-only;
    };

    psram@b0000000 {
        compatible = "mmio-sram";
        reg = <0x0 0xb0000000 0x0 0x8000000>;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <32768>;

        CPU0: cpu@0 {
            device_type = "cpu";
            reg = <0>;
            status = "okay";
            compatible = "mindgrove,c-class", "riscv";
            riscv,isa = "rv64imafdc";
            mmu-type = "riscv,sv39";
            clock-frequency = <1000000000>;
            phandle = <1>;
            CPU0_intc: interrupt-controller {
                #interrupt-cells = <1>;
                interrupt-controller;
                compatible = "riscv,cpu-intc";
            };
        };

        CPU1: cpu@1 {
            device_type = "cpu";
            reg = <1>;
            status = "okay";
            compatible = "mindgrove,c-class", "riscv";
            riscv,isa = "rv64imafdc";
            mmu-type = "riscv,sv39";
            clock-frequency = <1000000000>;
            phandle = <2>;
            CPU1_intc: interrupt-controller {
                #interrupt-cells = <1>;
                interrupt-controller;
                compatible = "riscv,cpu-intc";
            };
        };

        CPU2: cpu@2 {
            device_type = "cpu";
            reg = <2>;
            status = "okay";
            compatible = "mindgrove,c-class", "riscv";
            riscv,isa = "rv64imafdc";
            mmu-type = "riscv,sv39";
            clock-frequency = <1000000000>;
            phandle = <3>;
            CPU2_intc: interrupt-controller {
                #interrupt-cells = <1>;
                interrupt-controller;
                compatible = "riscv,cpu-intc";
            };
        };

        CPU3: cpu@3 {
            device_type = "cpu";
            reg = <3>;
            status = "okay";
            compatible = "mindgrove,c-class", "riscv";
            riscv,isa = "rv64imafdc";
            mmu-type = "riscv,sv39";
            clock-frequency = <1000000000>;
            phandle = <4>;
            CPU3_intc: interrupt-controller {
                #interrupt-cells = <1>;
                interrupt-controller;
                compatible = "riscv,cpu-intc";
            };
        };
    };

    soc {
        #address-cells = <2>;
        #size-cells = <2>;
        compatible = "mindgrove,v26xx-soc", "simple-bus";
        ranges;

        clint@2000000 {
            compatible = "riscv,clint0";
            interrupts-extended = <
                &CPU0_intc 3 &CPU0_intc 7
                &CPU1_intc 3 &CPU1_intc 7
                &CPU2_intc 3 &CPU2_intc 7
                &CPU3_intc 3 &CPU3_intc 7
            >;
            reg = <0x0 0x2000000 0x0 0xc0000>;
        };

        spi0: spi@20000 {
			compatible = "mindgrove,spi";
			reg = <0x0 0x20000 0x0 0x100>;
			spi-max-frequency = <35000000>;
			mindgrove,fifo-depth = <32>;
			mindgrove,max-bits-per-word = <8>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/* SPI-based SD card */
			mmc@0 {
				compatible = "mmc-spi-slot";
				reg = <0>;
				spi-max-frequency = <16000000>;
				voltage-ranges = <3200 3400>;
			};
		};
    };
    
    uart0: serial@11300 {
        compatible = "mindgrove,uart";
        reg = <0x0 0x11300 0x0 0x1000>;
        status = "okay";
        clock-frequency = <1000000000>;
        current-speed = <12500000>;
    };
};