#============================================================
# Minimal Mindgrove kernel boot environment
#============================================================

# kernel_addr_r=0x80060000
# fdt_addr_r=0x80e00000

kernel_addr_r=0x84000000
fdt_addr_r=0x86000000

mmcdev=0
mmcpart=2
kernel_file=/boot/uImage
fdt_file=/boot/mindgrove-v26xx.dtb

bootargs=earlycon=sbi console=hvc0 rw rootfs=ext4 root=/dev/mmcblk0p1 noinitrd rootwait maxcpus=4 selinux=0
bootload=ext4load mmc ${mmcdev}:${mmcpart} ${kernel_addr_r} ${kernel_file}; \
        ext4load mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdt_file}; \
        fdt addr ${fdt_addr_r}

boot=bootm ${kernel_addr_r} - ${fdt_addr_r}
